    {
      "id": 20,
      "type": "timeseries",
      "title": "SIEM: how far behind (oldest unsent audit row)",
      "description": "alert-svc sends every audit row to the SIEM (docs/siem.md). 0 = all sent; it grows while the SIEM is down and drops once it answers.",
      "datasource": {
