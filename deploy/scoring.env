# scoring-svc deploy config. Changing a pin means deploying a new model: review it in a PR.
# Pinned SHA-256 of models/fraud-lgbm-v1 (docs/model_card.md). Kept outside the model folder on
# purpose: whoever can replace the model files can also rewrite manifest.json, but not this file.
# This is the model scoring starts from; a signed promotion can replace it (docs/mlflow.md).
# Tuned v1, built by `python -m ml.train.train_final` on Urmi's laptop (Intel). Training is
# deterministic on one kind of CPU, but other CPUs give different files (Manisha's: 26eff82a), so
# these pins match this build only. Answers carry model_version fraud-lgbm-v1-535eb73c.
MODEL_DIR=/models/fraud-lgbm-v1
MODEL_SHA256_MODEL_TXT=535eb73c2fb2a62d97a65fb9b8cada048bb57408a429b88b1f8524a969228d70
MODEL_SHA256_META_JSON=abd0c05bccfc91a3802243f9adb3d41126d27915b9003747428a32fa4f1d2d0c
CASSANDRA_HOSTS=cassandra
# From measurements, not a guess (docs/results/safe_reads.md): 50 ms reads tripped the breaker during
# a slow period with Cassandra healthy. The breaker still limits the cost in a real outage.
CASSANDRA_READ_TIMEOUT_MS=150
CASSANDRA_WRITE_TIMEOUT_MS=500
KAFKA_BOOTSTRAP=redpanda:29092
MLFLOW_TRACKING_URI=http://mlflow:5000
PROMOTION_PUBLIC_KEY_PATH=/promotion/public.pem
# Probe detection, E6 defense D3 (store/probe.py): an approval on a card with 5 or more
# model-flagged payments in the 24 h before it goes to review. "off" only to show the attack
# working (make k8s-probe-attack D3=off); the cluster switches it back on afterwards.
PROBE_DETECTION=on
