# Data (Kaggle rules + GitHub size limits)
data/*
!data/README.md
*.csv
*.parquet
*.zip

# Python
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Models and experiment tracking (generated, can be large)
mlruns/
models/
*.pkl
*.joblib

# Logs
*.log

# Secrets
.env
# Decrypted cluster passwords must never be saved; only secrets.enc.env goes in git
deploy/k8s/*.env
!deploy/k8s/secrets.enc.env
keys.txt

# Editor and OS files
.vscode/
.claude/
.idea/
.DS_Store
# Platform (Urmi)
keys/
promotion-keys/
deploy/kong/kong.yml
.pytest_cache/
.ruff_cache/
.venv/

# Schemathesis (ST5) keeps a local cache here, with this folder's path in it
.schemathesis/
